# PostgreSQL Database URL
# Example for local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datascope

# Example for Neon DB (Serverless PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datascope

# NextAuth / JWT Secret
NEXTAUTH_SECRET=datascope-enterprise-jwt-super-secret-key-32-chars
NEXTAUTH_URL=http://localhost:3000
